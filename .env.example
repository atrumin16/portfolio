# ==============================================================================
# 💻 ALBERTO TRUJILLO PORTFOLIO - ENVIRONMENT VARIABLES CONFIGURATION
# Configure these in Cloudflare Dashboard (Pages -> Settings -> Environment Variables)
# OR locally in a .dev.vars file (never commit real keys to Git).
# ==============================================================================

# Resend API Key for contact form emails (obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Target recipient email for contact inquiries
CONTACT_EMAIL_TO=alberto@trujillomingorance.com

# Verified sender email
CONTACT_EMAIL_FROM=Alberto Trujillo <onboarding@resend.dev>
